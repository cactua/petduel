NUXT_SESSION_PASSWORD=almeno-32-caratteri-casuali
NUXT_VOTE_SECRET=altri-32-caratteri-casuali
# Cartella del database locale (PGlite)
PGLITE_DIR=./.data/pglite
# Solo sviluppo: posizione finta per le campagne mirate (paese|città|lat|lng). Senza, si è in Italia
# NUXT_DEV_GEO=IT|Torino|45.07|7.69
# Pagine privacy, cookie e termini: chi gestisce il sito (nome o ragione sociale, con indirizzo) e l'email per la privacy
NUXT_PUBLIC_LEGAL_OWNER="Nome Cognome, Via Esempio 1, 10100 Torino"
NUXT_PUBLIC_LEGAL_EMAIL=privacy@esempio.it

# Mappa dei rifugi: tile OpenStreetMap di default. Per molto traffico usa un fornitore di tile
# (es. MapTiler, Stadia, Thunderforest) e la sua attribuzione
# NUXT_PUBLIC_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Immagini su Cloudflare R2 invece che in .data/uploads (tutte e quattro, altrimenti restano su disco).
# Token "Object Read & Write" limitato al bucket del sito. Per copiare le immagini già caricate: npm run upload-to-r2 -- pets
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=petduel-uploads
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
