{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "petduel",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "furry",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:furry"
      ],
      "port": 3001
    },
    {
      "name": "moto",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:moto"
      ],
      "port": 3002
    },
    {
      "name": "petduel-esistente",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "storybook",
        "--",
        "--no-open"
      ],
      "port": 6006
    }
  ]
}
