{
  "name": "petduel",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^22.21.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run dev:pets",
    "dev:pets": "cd sites/pets && nuxt dev",
    "build:pets": "cd sites/pets && nuxt build",
    "preview:pets": "cd sites/pets && nuxt preview",
    "dev:furry": "cd sites/furry && nuxt dev --port 3001",
    "build:furry": "cd sites/furry && nuxt build",
    "preview:furry": "cd sites/furry && nuxt preview",
    "dev:moto": "cd sites/moto && nuxt dev --port 3002",
    "build:moto": "cd sites/moto && nuxt build",
    "preview:moto": "cd sites/moto && nuxt preview",
    "postinstall": "nuxt prepare sites/pets && nuxt prepare sites/furry && nuxt prepare sites/moto",
    "make-admin": "node scripts/make-admin.mjs",
    "upload-to-r2": "node scripts/upload-to-r2.mjs",
    "lint": "eslint .",
    "typecheck": "nuxi typecheck sites/pets && nuxi typecheck sites/furry && nuxi typecheck sites/moto",
    "test": "vitest run",
    "smoke": "node scripts/smoke-community.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "leaflet": "^1.9.4",
    "nuxt": "^4.6.3",
    "nuxt-auth-utils": "^0.5.34",
    "nuxt-security": "^2.5.1",
    "pg": "^8.23.1",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.14.0",
    "sass-embedded": "^1.107.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  }
}
